{
  "name": "example-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start": "ng serve --port 4200",
    "wait:app": "wait-on http://localhost:4200",
    "test:selenium": "dotnet test ./tests-selenium/UiTests/UiTests.csproj --logger \"trx;LogFileName=test-results.trx\"",
    "report:html": "TrxToExtentReport -t \"tests-selenium/UiTests/TestResults/test-results.trx\" -o \"tests-selenium/test-report/ExtentReport.html\"",
    "e2e": "concurrently -k -s first -n APP,TEST \"npm run start\" \"npm run wait:app && npm run test:selenium\"",
    "e2e:report": "npm run e2e && npm run report:html"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/localize": "^21.1.0",
    "@angular/material": "^21.1.0",
    "@angular/material-luxon-adapter": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/luxon": "^3.0.0",
    "@types/node": "^12.11.1",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.4"
  }
}
